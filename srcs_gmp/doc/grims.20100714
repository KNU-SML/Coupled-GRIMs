<                break
<          fi
<          if [ $rl -ne 0 ]; then
<                LONF=`expr $LONF + 1`
<          fi
<          i=`expr $i + 1`
<       done
<       if [ $i -eq $jcap ]; then
<          echo "$0 : set grid error"
<          exit 1
<       fi

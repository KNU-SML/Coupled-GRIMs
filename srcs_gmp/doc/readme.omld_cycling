Index: common/vargrb.F90
===================================================================
--- common/vargrb.F90	(revision 392)
+++ common/vargrb.F90	(working copy)
@@ -8,7 +8,7 @@
 
    implicit none
 
-   integer, parameter   ::  numgrbs=53
+   integer, parameter   ::  numgrbs=54
    integer, parameter   ::  kgrbmax=100
    integer,save         ::  kgrb(numgrbs)
    integer,save         ::  kpd(25,kgrbmax,numgrbs)
@@ -80,6 +80,7 @@
    integer,parameter    ::  itv1=51  ! soil temperature vic1
    integer,parameter    ::  isv2=52  ! soil moisture vic2
    integer,parameter    ::  itv2=53  ! soil temperature vic2
+   integer,parameter    ::  ioml=54  ! ocean mixed layer depth (m)
 !
 !  define various parameters for each field
 !
@@ -139,6 +140,7 @@
    data kgrb(itv1)/5/  ! soil temperature vic1
    data kgrb(isv2)/3/  ! soil moisture vic2
    data kgrb(itv2)/5/  ! soil temperature vic2
+   data kgrb(ioml)/1/  ! ocean mixed layer depth
 !
 !  2.  grib header record that identifies the field (kpd)
 !       number of soil-layers/field-types should not exceed kgrbmax
@@ -293,6 +295,7 @@
    data (kpd(igb,3,itv2),igb=1,25)/4*-1, 11, -1,10380,18*-1/ ! soilt vic2 3
    data (kpd(igb,4,itv2),igb=1,25)/4*-1, 11, -1, 2601,18*-1/ ! soilt vic2 2.1
    data (kpd(igb,5,itv2),igb=1,25)/4*-1, 11, -1,10381,18*-1/ ! soilt vic2 3.1
+   data (kpd(igb,1,ioml),igb=1,25)/4*-1,190, -1,   -1,18*-1/ ! ocean mixed layer
 !
 !  3. spacial interpolation type
 !     inttyp=0  bilinear
@@ -353,6 +356,7 @@
    data inttyp(itv1)/0/  ! soil temperature vic1
    data inttyp(isv2)/0/  ! soil moisture vic2
    data inttyp(itv2)/0/  ! soil temperature vic2
+   data inttyp(ioml)/0/  ! ocean mixed layer depth
 !
 !  4. maxmum possible dimension size of the grib input file (including
 !    climatology and analysis files (imdata,jmdata)
@@ -411,6 +415,7 @@
    data imdata(itv1),jmdata(itv1)/ 720, 280/ ! soil temperature vic1
    data imdata(isv2),jmdata(isv2)/ 720, 280/ ! soil moisture vic2
    data imdata(itv2),jmdata(itv2)/ 720, 280/ ! soil temperature vic2
+   data imdata(ioml),jmdata(ioml)/  360,180/ ! ocean mixed layer depth
 !
 !  5. flag whether to use land sea mask for interpolation
 !      mask=0  .. do not use mask
@@ -516,6 +521,9 @@
    data mask(itv1)/0/ ! soil tempeature vic1
    data mask(isv2)/0/ ! soil moisture vic2
    data mask(itv2)/0/ ! soil tempeature vic2
+   data mask(ioml)/1/ ! ocean mixed layer depth
+   data limask(ioml)/.true./
+   data cvalin(ioml),condin(ioml)/0.0,'le'/
 !
 !  6. scaling of the result by multiplying scale
 !
@@ -577,6 +585,7 @@
    data scale(itv1)/  1./ ! soil temperature vic1
    data scale(isv2)/  1./ ! soil moisture vic2
    data scale(itv2)/  1./ ! soil temperature vic2
+   data scale(ioml)/  1./ ! ocean mixed layer depth
 !
 !  7. flag for ouputting mask
 !       lomask=.true.  .. output 1 or 0 mask
@@ -645,6 +654,7 @@
    data lomask(itv1)/.false./ ! soil temperature vic1
    data lomask(isv2)/.false./ ! soil moisture vic2
    data lomask(itv2)/.false./ ! soil temperature vic2
+   data lomask(ioml)/.false./ ! ocean mixed layer depth
 !
 !  8.  flag for using the grib field over different land surface
 !      characteristics.
@@ -765,6 +775,8 @@
       .false.,.true.,.false.,.true.,.false./ ! soilt vic2
    data (lflgrb(igb,itv2),igb=1,5)/                                            &
       .false.,.true.,.false.,.true.,.false./ ! soilt vic2
+   data (lflgrb(igb,ioml),igb=1,5)/                                            &
+      .true.,.false.,.false.,.false.,.false./ ! ocean mixed layer depth
 !
 !  9.  full variable name (for print out purpose)
 !
@@ -822,6 +834,7 @@

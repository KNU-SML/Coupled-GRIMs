#
#  Makefile to create libraries and constants for grims
#
#  'make con' to create contants.
#  'make gcon' to create ssi contants.
#
#  'make clean_lib' to clean up lib.
#  'make clean_etc' to clean up etc.
#  'make clean_con' to clean up constants.
#  'make clean' to clean up lib, etc and con.
#
#  ncep sfm : 9/16/1998 Masao Kanamitsu
#
#  grims    : 11/11/2010 Songyou Hong
#
SHELL = @SHELL@
AR = @AR@
CP = @CP@
RM = @RM@
CD = @CD@
CC = @CC@
MKDIR = @MKDIR@
CHMOD = @CHMOD@
MAKE = @MAKE@
#
###################################################################
#

libs :
	${CD} lib ; ${MAKE} || exit 8
	${CD} etc ; ${MAKE}  || exit 8
	${CD} con ; ${MAKE} con || exit 8

ssi :
	${CD} lib ; ${MAKE} ssi || exit 8
	${CD} con ; ${MAKE} gcon || exit 8
	${CD} etc ; ${MAKE} ssi || exit 8

clean :  
	${CD} lib ; ${MAKE} clean
	${CD} etc ; ${MAKE} clean
	${CD} con ; ${MAKE} clean

clean_lib : 
	${CD} lib ; ${MAKE} clean

clean_etc : 
	${CD} etc ; ${MAKE} clean

clean_con : 
	${CD} con ; ${MAKE} clean


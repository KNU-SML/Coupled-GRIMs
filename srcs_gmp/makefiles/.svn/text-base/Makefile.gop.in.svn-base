#
#  Makefile to create executables for the grims forecast em.
#
#  'make gmp' to create global model executables.
#  'make rmp' to create rmp executables
#  'make gop' to create gop executables
#
#  'make clean_gmp' to clean up global model source codes compilation
#  'make clean_rmp' to clean up rmp source codes compilation
#  'make clean_gop' to clean up gop source codes compilation
#  'make clean' to clean up all compilation related files and directories
#
#  ncep sfm : 9/16/1998 Masao Kanamitsu
#
#  grims    : 11/11/2010 Songyou Hong
#
SHELL = @SHELL@
AR = @AR@
CP = @CP@
RM = @RM@
CD = @CD@
CC = @CC@
MKDIR = @MKDIR@
CHMOD = @CHMOD@
MAKE = @MAKE@
#
#  DIRECTORY STRUCTURE
#
#  ./src/[sfc][chgr][fcst][co2][mtn].../*.fp  Program files 
#
###################################################################
#

all : 
	${CD} src ; ${MAKE} all  || exit 8

gop : 
	${CD} src ; ${MAKE} gop || exit 8

clean : 
	${CD} src ; ${MAKE} clean
	${CD} src ; ${MAKE} clean_gop

clean_gop : 
	${CD} src ; ${MAKE} clean_gop

dist_clean :
	${CD} src ; ${MAKE} dist_clean_gop
	${CD} src ; ${MAKE} dist_clean
	- ${RM} Makefile options* *.h configure.log cvar.env

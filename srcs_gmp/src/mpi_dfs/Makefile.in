LIB = mpi.a
LIB2 = ../share/share.a
OBJS = commpi.o dfsvar.o dimset.o mpdimset.o mpgetspd.o mpsumall.o \
	mpbcasti.o mpbcastr.o mpbcastl.o mpabort.o  mpbcastc.o mpsf2mz.o mpmz2f.o \
	equdiv.o equdis.o mpfine.o mpinit.o mpgf2p.o mpgp2f.o mpsf2p.o mpsp2f.o \
	mpxy2yz.o mpxy2y.o mpyz2xy.o mpy2xy.o mpmz2yz.o mpyz2mz.o mpadjl.o mpadjlm.o \
	mpmn2mz.o mpmn2m.o mpmz2mn.o mpm2mn.o mpmz2z.o mpm2mz.o mpm2m.o mpnbnd.o mpm2f.o \
	mpgf2xk.o mpxk2f.o mpgf2yk.o mpyk2f.o mpgf2pd.o mpgp2fd.o farg.o mpbcastr_col.o \
    mpmz2m.o mpsumrow.o

SRCS = ${OBJS:o=F90}
SRC_FCST = dfsvar.F90
ALL = ${LIB}

MACHINE = @MACHINE@
SHELL = @SHELL@
AR = @AR@
CP = @CP@
RM = @RM@
CD = @CD@
CHMOD = @CHMOD@

CC = @CC@
CPP = @CPP@
F77 = @F77_FCST@
FORT_FLAGS = @FORT_FLAGS@
LOAD_FLAGS = @LOAD_FLAGS@
INCLUDE_DIR = @INCLUDE_DIR@
LIB_DIR = @LIB_DIR@
INSTALL_DIR = @INSTALL_DIR@
EXRTA_LIBS = @EXTRA_LIBS@

all : ${ALL}

${SRCS} :
	if [ -f ../common/$@ ]; then     \
		ln -s ../common/$@ $@; \
	elif [ -f ../mpi/$@ ]; then   \
		ln -s ../mpi/$@ $@;    \
	fi

${LIB} : ${SRCS} ${OBJS}
	${AR} -r $@ ${OBJS}
	${CP} $@ ${INSTALL_DIR}

yftest.x : yftest.o ${LIB} ${LIB2}
	 ${F77} ${LOAD_FLAGS} -o $@ yftest.o ${LIB} ${LIB2}

depend :
	${LIB_DIR}/../etc/mkdep

.SUFFIXES : .o .f90 .F90

.F90.f90 :
	${CPP} -P ${INCLUDE_DIR} $*.F90 >$*.i
	sed '/^ *$$/d;s/\/\*/\!/' $*.i >$*.f90 ; rm $*.i

.F90.o :
	${CPP} -P ${INCLUDE_DIR} $*.F90 >$*.i
	sed '/^ *$$/d;s/\/\*/\!/' $*.i >$*.f90 ; rm $*.i
	${F77} ${FORT_FLAGS} -c $*.f90

.f90.o :
	${F77} ${FORT_FLAGS} -c $*.f90

clean :
	- ${RM} -f *.f90 *.o *.x core ${SRC_FCST} ${ALL}
	- find ./ -type l -exec rm -f {} \;

dist_clean :
	make clean; ${RM} -f Makefile

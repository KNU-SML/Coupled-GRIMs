!
   module vic_veglib
!-------------------------------------------------------------------------------
!
! vic vegetation library
! total 12 vegetation type used in VIC
!   
!     1. Evergreen Needleleaf
!     2. Evergreen Broadleaf
!     3. Deciduous Needleleaf
!     4. Deciduous Broadleaf
!     5. Mixed Cover
!     6. Woodland
!     7. Wooded Grasslands
!     8. Closed Shrublands
!     9. Open Shrublands
!    10. Grasslands
!    11. Crop land (corn)
!    12. no vegetation (bare soil)
!        
! veg_lib:
!     veg_ost(vegtype)
!     veg_Rarc(vegtype)
!     veg_Rmin(vegtype)
!     veg_windH(vegtype)

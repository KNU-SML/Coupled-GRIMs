#!/bin/sh
#
hx=$1
EXECDIR=${EXECDIR:=`pwd`}
#
npost=1
while [ $npost -ne 0 ]; do
        sleep 10
     if [ "@MODEL@" = rmp ]; then
        hxrest=`@ETC_DIR@/fhour ${EXECDIR}/r_sigit`
     else
        hxrest=`@ETC_DIR@/fhour ${EXECDIR}/sigit`
     fi
        if [ $hx -eq $hxrest ]; then
        npost=0
        fi
done
if [ "@MODEL@" = rmp ]; then
     echo "now r_sigit is updated to " $hx
else
     echo "now sigit is updated to " $hx
fi
sleep 10
exit 0


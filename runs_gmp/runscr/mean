set -x
overwrite=no
for f in pgb fgb
do
	for month in 01 02 03 04 05 06 07 08 09 10 11 12
	do
		if [ "$overwrite" = yes -o ! -s $f.$month.avrg.grib ] ; then
			/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/etc/grmean -o $f.$month.avrg.grib $f.%y4$month.avrg.grib
		fi
		if [ "$overwrite" = yes -o ! -s $f.$month.avrg.grib.ctl ] ; then
			/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/etc/grmap -g0 $f.$month.avrg.grib
		fi
	done
	#
	for season in djf mam jja son jfm amj jas ond
	do
		if [ $season = djf ] ; then
			mons='12 01 02'
		elif [ $season = mam ] ; then
			mons='03 04 05'
		elif [ $season = jja ] ; then
			mons='06 07 08'
		elif [ $season = son ] ; then
			mons='09 10 11'
		elif [ $season = jfm ] ; then
			mons='01 02 03'
		elif [ $season = amj ] ; then
			mons='04 05 06'
		elif [ $season = jas ] ; then
			mons='07 08 09'
		elif [ $season = ond ] ; then
			mons='10 11 12'
		fi
		rm filelist 2>/dev/null
		for mon in $mons
		do
			echo "`pwd`/$f.$mon.avrg.grib" >>filelist
		done
		if [ "$overwrite" = yes -o ! -s $f.$season.avrg.grib ] ; then
			/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/etc/grmean -o $f.$season.avrg.grib -s filelist
		fi
		if [ "$overwrite" = yes -o ! -s $f.$season.avrg.grib.ctl ] ; then
			/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/etc/grmap -g0 $f.$season.avrg.grib
		fi
	done
	#
	#  ENSO Warm and cold composite
	#
	#  List taken from CPC web page
	#
	jfm_warm='1958 1966 1969 1973 1983 1987 1992 1995 1998'
	jfm_warm_minus="1959 1970 1978 1980 1988 1991 1993"
	jfm_cold='1950 1951 1955 1956 1971 1974 1976 1989 1999'
	jfm_cold_minus="1965 1975 1984 1985 1996"
	#
	amj_warm='1958 1983 1987 1992 1993 1997 1998'
	amj_warm_minus="1953 1957 1966 1969 1972 1982 1991"
	amj_cold='1950 1956 1974 1999'
	amj_cold_minus="1955 1971 1975 1984 1985 1989"
	#
	jas_warm='1965 1972 1982 1987 1991 1993 1994 1997'
	jas_warm_minus="1953 1957 1958 1963 1966 1969 1986 1990 1992"
	jas_cold='1950 1956 1975'
	jas_cold_minus="1954 1955 1964 1971 1973 1974 1988 1998 1999"
	#
	ond_warm='1957 1963 1965 1972 1982 1986 1987 1991 1994 1997'
	ond_warm_minus="1951 1958 1968 1969 1976 1977 1990 1992 1993"
	ond_cold='1950 1954 1955 1964 1970 1973 1975 1988 1998'
	ond_cold_minus="1956 1971 1974 1983 1984 1995"
	#
	for season in jfm amj jas ond
	do
		for events in warm cold
		do
			years=\$${season}_$events
			years=`eval echo $years`
			rm filelist >/dev/null
			echo $years
			for year in $years
			do
				if [ $season = jfm ] ; then
					mons='01 02 03'
				elif [ $season = amj ] ; then
					mons='04 05 06'
				elif [ $season = jas ] ; then
					mons='07 08 09'
				elif [ $season = ond ] ; then
					mons='10 11 12'
				fi
				for mon in $mons
				do
					if [ -s `pwd`/$f.${year}$mon.avrg.grib ] ; then
						echo "`pwd`/$f.${year}$mon.avrg.grib" >>filelist
					fi
				done
			done
			if [ "$overwrite" = yes -o ! -s $f.$season.$events.avrg.grib ] ; then
				/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/etc/grmean -o $f.$season.$events.avrg.grib -s filelist
			fi
			if [ "$overwrite" = yes -o ! -s $f.$season.$events.avrg.grib.ctl ] ; then
				/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/etc/grmap -g0 $f.$season.$events.avrg.grib
			fi
			#
			years_minus=\$${season}_${events}_minus
			years_minus=`eval echo $years_minus`
			echo $years_minus
			for year in $years_minus 
			do
				for mon in $mons
				do
					if [ -s `pwd`/$f.${year}$mon.avrg.grib ] ; then
						echo "`pwd`/$f.${year}$mon.avrg.grib" >>filelist
					fi
				done
			done
			if [ "$overwrite" = yes -o ! -s $f.$season.all_$events.avrg.grib ] ; then
				/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/etc/grmean -o $f.$season.all_$events.avrg.grib -s filelist
			fi
			if [ "$overwrite" = yes -o ! -s $f.$season.all_$events.avrg.grib.ctl ] ; then
				/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/etc/grmap -g0 $f.$season.all_$events.avrg.grib
			fi
		done
	done
done
rm filelist

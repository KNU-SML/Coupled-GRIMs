#!/bin/sh
#------------------------------------------------------------------end_of_header
set -ax
#
if [ @SYSTEM@ = linux_pgi ]; then
export NO_STOP_MESSAGE=1
fi
export MPIEXEC_TIMEOUT=15   # to prevent qdel error
#
if [ "$EXECDIR" != "" ]; then
    cd $EXECDIR
fi
#
#  execute forecast.
#
#  $1 ... starting forecast hour
#  $2 ... ending   forecast hour
#  $3 ... base field interval (hour)
#  $4 ... regional field output interval (hour)
#
PROG=rfcst
#
#  Execute forecast
#
h=${h:=$1}
hx=${hx:=$2}
inchour=${inchour:=$3}
prthour=${prthour:=$4}
if [ "$prthour" = "" ] ; then
    echo "`date` $0: argument error" >>ERROR.out
    exit 8
fi
#
fh=`@ETC_DIR@/fhour r_sigit`
#
# SWRMDC
#
swrmdc=`fgrep SWRMDC @SRCS_DIR@/define.h | fgrep -v undef | fgrep define | wc -l`
if [ $swrmdc -eq 1 ]; then
    mon=01
    while [ $mon -le 12 ]; do
        @FTASS@ @CON_DIR@/global_aeropac3a.m${mon}.txt .
        mon=`expr $mon + 1`
        if [ $mon -lt 10 ]; then
            mon=0$mon
        fi
    done
fi
#
if [ @SYSTEM@ = x1e ] ; then
        FILENV=filenv.$$
        export FILENV
        assign -R
else
        rm -f @FTNID@[0-9]* 2>/dev/null
fi
#
sleep 10
#
@FTASS@ @RUNS_DIR@/namelist.@SCRIPT@               @FTNID@1
@FTASS@ $EXECDIR/co2con                            @FTNID@15
@FTASS@ $EXECDIR/r_mtnvar                          @FTNID@24
@FTASS@ @CON_DIR@/o3prod.clim.asc                  @FTNID@28
@FTASS@ @CON_DIR@/o3loss.clim.asc                  @FTNID@29
@FTASS@ $EXECDIR/r_sigit                           @FTNID@30
@FTASS@ $EXECDIR/r_sigitdt                         @FTNID@31
@FTASS@ $EXECDIR/r_sfci                            @FTNID@32
@FTASS@ @CON_DIR@/flwdirGSWP2.hlf.asc              @FTNID@41 
@FTASS@ @CON_DIR@/tune.t42l18.amip.ewmrg           @FTNID@43
@FTASS@ @CON_DIR@/gcmo3.asc                        @FTNID@48
#
rm -f $PROG.x
if [ @MARCH@ = mpi -o @MARCH@ = hybrid ] ; then
	@FTASS@ @BIN_DIR@/${PROG}_par.x $PROG.x
else
	@FTASS@ @BIN_DIR@/${PROG}.x $PROG.x
fi
#
if [ @SYSTEM@ = dec ] ; then
    datasize=1048576
    stacksize=3276800
else
    datasize=unlimited
    stacksize=unlimited
fi
ulimit -s $datasize
ulimit -c $stacksize
#
here_dir=`pwd`
if [ @HOST_NAME@ = compas_linux -a @MARCH@ != single -a @MARCH@ != thread ] ; then
    sed -n "1,${FCST_NPES}p" $HOME/node_list >$here_dir/hostfile
	@FTASS@ $PROG.parm @FTNID@95
    /opt/mpich/myrinet/pgi/bin/mpirun -nolocal -np ${FCST_NPES} -machinefile $here_dir/hostfile $here_dir/$PROG.x 1>$here_dir/r_fcstout.ft$hx 2>&1
else
	@FTASS@ $PROG.parm @FTNID@95
	@FCSTENV@ ./$PROG.x 1> r_fcstout.ft$hx 2>&1
fi
if [ $? -ne 0 ] ; then
	echo "r_fcst failed" >>ERROR.out
	exit 8
fi
grep 'NaN' r_fcstout.ft$hx
if [ $? -eq 0 ]; then
        echo "The run has NaN crushed !!!" >> ERROR.out
        exit 8
fi
grep ' nan ' r_fcstout.ft$hx
if [ $? -eq 0 ]; then
        echo "The run has NaN crushed !!!" >> ERROR.out
        exit 8
fi
grep '<WARNING>:' r_fcstout.ft$hx >>ERROR.out
rm -f @FTNID@[0-9]* >/dev/null
#
exit 0

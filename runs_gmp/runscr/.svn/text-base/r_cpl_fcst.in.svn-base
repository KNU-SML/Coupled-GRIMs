#!/bin/sh
#------------------------------------------------------------------end_of_header
set -ax
if [ "$EXECDIR" != "" ]; then
    cd $EXECDIR
fi
#
#  execute forecast.
#
#  $1 ... starting forecast hour
#  $2 ... ending   forecast hour
#  $3 ... base field interval (hour)
#  $4 ... regional field output interval (hour)
#
@MPMD_COMMAND@
#
h=${h:=$1}
hx=${hx:=$2}
inchour=${inchour:=$3}
prthour=${prthour:=$4}
if [ "$prthour" = "" ] ; then
    echo "`date` $0: argument error" >>ERROR.out
    exit 8
fi
#
PROG1=rfcst
PROG1_NPES=@RMP_NPES@
PROG2=roms
PROG2_NPES=@ROM_NPES@
#
fh=`@ETC_DIR@/fhour r_sigit`
#
# SWRMDC
#
swrmdc=`fgrep SWRMDC @SRCS_DIR@/define.h | fgrep -v undef | fgrep define | wc -l`
if [ $swrmdc -eq 1 ]; then
    mon=01
    while [ $mon -le 12 ]; do
        @FTASS@ @CON_DIR@/global_aeropac3a.m${mon}.txt .
        mon=`expr $mon + 1`
        if [ $mon -lt 10 ]; then
            mon=0$mon
        fi
    done
fi
#
if [ @SYSTEM@ = x1e ] ; then
        FILENV=filenv.$$
        export FILENV
        assign -R
else
        rm -f @FTNID@[0-9]* 2>/dev/null
fi
#
@FTASS@ @RUNS_DIR@/namelist.@SCRIPT@               @FTNID@1
@FTASS@ $EXECDIR/co2con                            @FTNID@15
@FTASS@ $EXECDIR/r_mtnvar                          @FTNID@24
@FTASS@ @CON_DIR@/o3prod.clim.asc                  @FTNID@28
@FTASS@ @CON_DIR@/o3loss.clim.asc                  @FTNID@29
@FTASS@ $EXECDIR/r_sigit                           @FTNID@30
@FTASS@ $EXECDIR/r_sigitdt                         @FTNID@31
@FTASS@ $EXECDIR/r_sfci                            @FTNID@32
@FTASS@ @CON_DIR@/flwdirGSWP2.hlf.asc              @FTNID@41
@FTASS@ @CON_DIR@/tune.t42l18.amip.ewmrg           @FTNID@43
@FTASS@ @CON_DIR@/gcmo3.asc                        @FTNID@48
#
cp @LIBS_DIR@/con_rop/varinfo.dat .
rm -f $PROG1.x $PROG2.x
if [ @MARCH@ = mpi -o @MARCH@ = hybrid ] ; then
    @FTASS@ @BIN_DIR@/${PROG1}_par.x $PROG1.x
    @FTASS@ @BIN_DIR@/${PROG2}.x $PROG2.x
	@FTASS@ @RUNSCR_DIR@/${PROG2}.parm ${PROG2}.parm
else
    @FTASS@ @BIN_DIR@/${PROG1}.x $PROG1.x
    @FTASS@ @BIN_DIR@/${PROG2}.x $PROG2.x
	@FTASS@ @RUNSCR_DIR@/${PROG2}.parm ${PROG2}.parm
fi
#
if [ @SYSTEM@ = dec ] ; then
    datasize=1048576
    stacksize=3276800
else
    datasize=unlimited
    stacksize=unlimited
fi
ulimit -s $datasize
ulimit -c $stacksize
#
here_dir=`pwd`
rm -f myfile
touch myfile
cat <<EOF >myfile
./$PROG1.x:$PROG1_NPES
./$PROG2.x $PROG2.parm:$PROG2_NPES
EOF
#
if [ @MARCH@ = mpi -o @MARCH@ = hybrid ] ; then
	@FTASS@ $PROG1.parm @FTNID@95
    #@FCSTENV@ -cmdfile myfile 1> r_fcstout.ft$hx 2>&1
    mpiexec -n $PROG1_NPES ./$PROG1.x : -n $PROG2_NPES ./$PROG2.x $PROG2.parm 1> r_fcstout.ft$hx 2>&1
else
	echo "couping with single or thread mode not possible" >>ERROR.out
	echo "couping with single or thread mode not possible"
	exit 8
fi
grep 'NaN' r_fcstout.ft$hx
if [ $? -eq 0 ]; then
        echo "The run has NaN crushed !!!" >> ERROR.out
        exit 8
fi
grep 'nan' r_fcstout.ft$hx
if [ $? -eq 0 ]; then
        echo "The run has nan crushed !!!" >> ERROR.out
        exit 8
fi
grep '<WARNING>:' r_fcstout.ft$hx >>ERROR.out
#
exit 0

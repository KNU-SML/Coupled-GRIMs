#!/bin/sh
set -x
#######################################################################

## YMDH=$1
## STRHOUR=$2
## ENDHOUR=$3

YMDH=${YMDH:=$1}
STRHOUR=${STRHOUR:=$2}
ENDHOUR=${ENDHOUR:=$3}

#######################################################################
cd ${EXECDIR}

if [ @SYSTEM@ = linux ] ; then
NPROC=`cat $PBS_NODEFILE | wc -l`
fi

cp  @BIN_DIR@/gom_coupa2o.x .

if [ @SYSTEM@ = x1e ] ; then
        FILENV=filenv.$$
        export FILENV
        assign -R
else
        rm -f u:[0-9]* 2>/dev/null
fi

/bin/rm -r *gr *dat

#
cp @CONGOP_DIR@/gom_gridsT62yg.asc ./gridsT62yg.dat
cp @CONGOP_DIR@/gom_gridsMOM3.asc  ./gridsMOM3.dat
#
cp @CONGOP_DIR@/gom_maskMOM3.asc   ./maskMOM3.asc
#
wgrib=@ETC_DIR@/wgrib
#
# create fluxes for ocean component (MOM3)
#

if [ -f flxMOM3.gr ]; then
 rm flxMOM3.gr
fi

set +e
rm -f flxcplgrb*
set -e

# start extract
# 6, 12, 18 UTC and 24 UTC  

# first 06 UTC

hhs=`expr $STRHOUR + 6`
FH=$hhs
  if [ $FH -lt 10 ] ; then
           FH=0$FH
  fi
cpldate=`@ETC_DIR@/validate.s $YMDH $FH`  ;# date of current coupling episode

varlist=':UFLX:|:VFLX:|:DSWRF:sfc:|:USWRF:sfc:|:DLWRF:sfc:|:ULWRF:sfc:|:PRATE:|:LHTFL:|:SHTFL:|:LAND:'

flxcplgrb=flxcplgrb06

  $wgrib fgb.$cpldate -s | egrep "($varlist)" | $wgrib fgb.$cpldate -o $flxcplgrb -grib -append -s -i 
  @ETC_DIR@/force_grib_date_mon $flxcplgrb $cpldate

# second 12 UTC

hhs=`expr $FH + 6`

FH=$hhs
cpldate=`@ETC_DIR@/validate.s $YMDH $FH`  ;# date of current coupling episode

varlist=':UFLX:|:VFLX:|:DSWRF:sfc:|:USWRF:sfc:|:DLWRF:sfc:|:ULWRF:sfc:|:PRATE:|:LHTFL:|:SHTFL:|:LAND:'

flxcplgrb=flxcplgrb12

  $wgrib fgb.$cpldate -s | egrep "($varlist)" | $wgrib fgb.$cpldate -o $flxcplgrb -grib -append -s -i
  @ETC_DIR@/force_grib_date_mon $flxcplgrb $cpldate

# third 18 UTC

hhs=`expr $FH + 6`

FH=$hhs
cpldate=`@ETC_DIR@/validate.s $YMDH $FH`  ;# date of current coupling episode

varlist=':UFLX:|:VFLX:|:DSWRF:sfc:|:USWRF:sfc:|:DLWRF:sfc:|:ULWRF:sfc:|:PRATE:|:LHTFL:|:SHTFL:|:LAND:'

flxcplgrb=flxcplgrb18

  $wgrib fgb.$cpldate -s | egrep "($varlist)" | $wgrib fgb.$cpldate -o $flxcplgrb -grib -append -s -i
  @ETC_DIR@/force_grib_date_mon $flxcplgrb $cpldate

# forth 24 UTC

hhs=`expr $FH + 6`

FH=$hhs
cpldate=`@ETC_DIR@/validate.s $YMDH $FH`  ;# date of current coupling episode

varlist=':UFLX:|:VFLX:|:DSWRF:sfc:|:USWRF:sfc:|:DLWRF:sfc:|:ULWRF:sfc:|:PRATE:|:LHTFL:|:SHTFL:|:LAND:'

flxcplgrb=flxcplgrb24

  $wgrib fgb.$cpldate -s | egrep "($varlist)" | $wgrib fgb.$cpldate -o $flxcplgrb -grib -append -s -i
  @ETC_DIR@/force_grib_date_mon $flxcplgrb $cpldate

############################
# end extract
############################

     ./gom_coupa2o.x 1>coupa2o_out.ft$STRHOUR 2>&1

cpldate=`@ETC_DIR@/validate.s $YMDH $STRHOUR` 

yycur=`echo $cpldate | cut -c1-4`   ;#start year of this job
mmcur=`echo $cpldate | cut -c5-6`
ddcur=`echo $cpldate | cut -c7-8`

  mkdir -p mom3_data
  cp flxMOM3.gr ./mom3_data/flxMOM3$yycur$mmcur$ddcur.gr

rm -f u:[0-9]* 
exit 0


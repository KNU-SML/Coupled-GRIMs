#!/bin/sh
set -x
#
if [ $# -ne 5 ] ; then
	echo $0:  argument error
	exit 8
fi
#
# Change resolution
#
# $1 is input sigma file
# $2 is input sfc file
# $3 is output sigma file
# $4 is output sfc file
# $5 is input sfc file type (osu1 osu2 noa1 vic1)
#
#
in_sig=$1
in_sfc=$2
out_sig=$3
out_sfc=$4
sfcftyp=$5
#
issig=1
issfc=1
if [ $in_sig = "dummy" ]; then
   issig=0
fi
if [ $in_sfc = "dummy" ]; then
   issfc=0
fi
#
fnsporog=orospc.smth
lrep='.TRUE.'
ltrn='.TRUE.'
lnew='.TRUE.'
#
PROG=chgr
atm_unit=53
#
if [ @SYSTEM@ = x1e ] ; then
        FILENV=filenv.$$
        export FILENV
        assign -R
else
        rm -f @FTNID@[0-9]* 2>/dev/null
fi 
if [ @SYSTEM@ = cray -o @SYSTEM@ = t90 -o @SYSTEM@ = t3e ] ; then
	assign -R
fi
if [ $issig -eq 1 ]; then
   @FTASS@ $in_sig                    @FTNID@11
   @FTASS@ $out_sig                   @FTNID@51
fi
if [ $issfc -eq 1 ]; then
   @FTASS@ $in_sfc                    @FTNID@14
   @FTASS@ $out_sfc                   @FTNID@52
fi
@FTASS@ $fnsporog                     @FTNID@12
@FTASS@ slmsk                         @FTNID@13
@FTASS@ @RUNS_DIR@/namelist.@SCRIPT@  @FTNID@1
if [ "@MODEL@" = dfs ]; then
    ln -fs @CON_DIR@/standard_atm.asc       @FTNID@${atm_unit} || exit 8
fi

if [ @MODEL@ = dfs ]; then
	cat >${PROG}.parm <<EOF
   &NAMCHGR
 	NIN=11,NOU=51,LTRN=$ltrn,LNEW=$lnew,LREP=$lrep,
 	SFCFTYP='$sfcftyp',IUNIT=${atm_unit},
   ISSIG=$issig, ISSFC=$issfc,
	/
EOF
else
	cat >${PROG}.parm <<EOF
   &NAMCHGR
 	NIN=11,NOU=51,LTRN=$ltrn,LNEW=$lnew,LREP=$lrep,
 	SFCFTYP='$sfcftyp',
   ISSIG=$issig, ISSFC=$issfc,
	/
EOF
fi
#
if [ @SYSTEM@ = dec ];then
   ulimit -s 1024000
else
   ulimit -s unlimited
fi
#
rm -f $PROG.x
ln -s @BIN_DIR@/${PROG}.x $PROG.x
@RUNENV@ ./$PROG.x <$PROG.parm 1>$PROG.out 2>&1
if [ $? -ne 0 ] ; then
	echo "`date` $0: execution failed." >>ERROR.out
  exit 8
fi
if [ ! -s $in_sfc ] ; then
	rm $out_sfc
fi
#
rm -f @FTNID@[0-9]*
exit 0

fi
#
cat > $namfile << EOF
&paralist
  ncpus_ = @NCPUS@,
  jcap_  = @JCAP@,
  levs_  = @LEVS@,
  ilonf_ = @ILONF@,
  ilatg_ = @ILATG@,
  ijcap_ = @IJCAP@,
  ilevs_ = @ILEVS@,
  io_    = @POST_IGRD@,
  jo_    = @POST_JGRD@,
  ko_    = @POST_LAYER@,
EOF
if [ @MODEL@ = rmp -o  @MODEL@ = rop ] ; then
echo "  irelx_ = @IRELX@,"        >> $namfile
echo "  igrd_  = @IGRD@,"         >> $namfile
echo "  jgrd_  = @JGRD@,"         >> $namfile
if [ @CIGRD1@ != 1 -a @CJGRD1@ != 1 ] ; then
echo "  cigrd1_  = @CIGRD1@,"     >> $namfile
echo "  cjgrd1_  = @CJGRD1@,"     >> $namfile
fi
fi
if [ @MARCH@ = mpi -o @MARCH@ = hybrid ] ; then
if [ @MODEL@ = rop ] ; then
echo "  npes_  = @RMP_NPES@,"     >> $namfile
else
echo "  npes_  = @NPES@,"         >> $namfile
fi
echo "  ncol_  = @NCOL@,"         >> $namfile
fi
echo "/"                          >> $namfile

cat >> $namfile << EOF

&modlsig
  delmdl = $model_sig,
/

&postpres
  po = $post_level,
/
EOF

if [ @MODEL@ = sph -o \
     @MODEL@ = dfs -o \
     @MODEL@ = chm -o \
     @MODEL@ = gsi -o \
     @MODEL@ = mul ] ; then
cat >> $namfile << EOF

&modlhyb
  akmdl = $model_hybA,
  bkmdl = $model_hybB,
/
EOF
fi

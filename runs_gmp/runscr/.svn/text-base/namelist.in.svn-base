if [ @POST_LAYER@ = 12 ] ; then
  post_level="1000.,925.,850.,700.,600.,500.,400.,300.,250.,200.,150.,100."
elif [ @POST_LAYER@ = 17 ] ; then
  post_level="1000.,925.,850.,700.,600.,500.,400.,300.,250.,200.,150.,100.,70.,50.,30.,20.,10." 
elif [ @POST_LAYER@ = 21 ] ; then
  post_level="1000.,925.,850.,700.,600.,500.,400.,300.,250.,200.,150.,100.,70.,50.,30.,20.,10.,7.,5.,3.,1." 

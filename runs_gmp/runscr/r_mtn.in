PROG=rmtn
#
set -x
#
if [ @GTOPO30@ = no ] ; then
	mtnres=` grep '^mtnres=' @SRCS_DIR@/cvar.env | cut -d'=' -f2`
	avg=top${mtnres}m_avg.20i4.asc
	var=top${mtnres}m_var.20i4.asc
	max=top${mtnres}m_max.20i4.asc
	slm=top${mtnres}m_slm.80i1.asc
	for file in $avg $var $max $slm
	do
		if [ ! -s $file ] ; then
			cp @CON_DIR@/$file.Z . && gunzip $file.Z
		fi
	done
	cp rsm.parm rmtn.parm
else
	avg=dummy1
	var=dummy2
	max=dymmy3
	slm=dummy4
	echo " &namcondir" >condir.parm
	echo " condir='@CON_DIR@'," >>condir.parm
	echo "/" >>condir.parm
	cat rsm.parm condir.parm >rmtn.parm
fi
#
if [ @SYSTEM@ = x1e ] ; then
        FILENV=filenv.$$
        export FILENV
        assign -R
else
        rm -f @FTNID@[0-9]* 2>/dev/null
fi

@FTASS@ $avg                           @FTNID@11
@FTASS@ $var                           @FTNID@12
@FTASS@ $max                           @FTNID@13
@FTASS@ $slm                           @FTNID@14
@FTASS@ r_slmsk                        @FTNID@51
@FTASS@ r_orogrd                       @FTNID@52
@FTASS@ r_mtnvar                       @FTNID@53
@FTASS@ r_oroggd                       @FTNID@54
@FTASS@ r_smooth_oroggd                @FTNID@55
@FTASS@ r_oroview.ieee                 @FTNID@71
@FTASS@ r_oroview_latlon.ieee          @FTNID@72
@FTASS@ @RUNS_DIR@/namelist.@SCRIPT@   @FTNID@1
#
if [ @SYSTEM@ = dec ]; then
  ulimit -s 1024000
else
  ulimit -s unlimited
fi
#
rm $PROG.x 2>/dev/null
@FTASS@  @BIN_DIR@/$PROG.x $PROG.x
./$PROG.x <rmtn.parm 1>$PROG.out 2>&1
if [ $? -ne 0 ] ; then
  exit 8
fi

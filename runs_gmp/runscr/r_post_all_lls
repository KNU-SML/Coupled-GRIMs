#!/bin/sh
#@ job_type = serial
#@ class = class.1-2
#@ resources = ConsumableCpus(1) ConsumableMemory(2000mb)
#@ wall_clock_limit = 06:00:00
#@ output = $(jobid).out
#@ error = $(output)
#@ environment = $EXECDIR; $YYYY; $MM; $DD; $HH; $h; $hx; $YYYYS; $MMS; $FHLEN; $ENDHOUR
#@ environment = $INTPOST; $INCHOUR; $NESTING_HOUR; $DELETE_BASE
#@ environment = $FILES_TO_BE_AVERAGED; $FILES_TO_BE_KEPT; $LIST_OF_FILES
#@ notification = never
#@ queue
export MEMORY_AFFINITY=MCM
#
EXECDIR=${EXECDIR:=`pwd`}
cd $EXECDIR
#
YYYY=`grep "YYYY " ${EXECDIR}/post_all.info | nawk '{print $2}' `
MM=`grep "MM " ${EXECDIR}/post_all.info | nawk '{print $2}' `
DD=`grep "DD " ${EXECDIR}/post_all.info | nawk '{print $2}' `
HH=`grep "HH " ${EXECDIR}/post_all.info | nawk '{print $2}' `
h=`grep "h " ${EXECDIR}/post_all.info | nawk '{print $2}' `
hx=`grep "hx " ${EXECDIR}/post_all.info | nawk '{print $2}' `
YYYYS=`grep "YYYYS " ${EXECDIR}/post_all.info | nawk '{print $2}' `
MMS=`grep "MMS " ${EXECDIR}/post_all.info | nawk '{print $2}' `
FHLEN=`grep "FHLEN " ${EXECDIR}/post_all.info | nawk '{print $2}' `
ENDHOUR=`grep "ENDHOUR " ${EXECDIR}/post_all.info | nawk '{print $2}' `
INTPOST=`grep "INTPOST " ${EXECDIR}/post_all.info | nawk '{print $2}' `
INCHOUR=`grep "INCHOUR " ${EXECDIR}/post_all.info | nawk '{print $2}' `
NESTING_HOUR=`grep "NESTING_HOUR " ${EXECDIR}/post_all.info | nawk '{print $2}' `
DELETE_BASE=`grep "DELETE_BASE " ${EXECDIR}/post_all.info | nawk '{print $2}' `
##
## YYYY=${YYYY:=$1}
## MM=${MM:=$2}
## DD=${DD:=$3}
## HH=${HH:=$4}
## h=${h:=$5}
## hx=${hx:=$6}
## YYYYS=${YYYYS:=$7}
## MMS=${MMS:=$8}
## FHLEN=${FHLEN:=$9}
## ENDHOUR=${ENDHOUR:=${10}}
## INTPOST=${INTPOST:=${11}}
## INCHOUR=${INCHOUR:=${12}}
## NESTING_HOUR=${NESTING_HOUR:=${13}}
## DELETE_BASE=${DELETE_BASE:=${14}}
#
# post
#
cp r_sigit.ft$hx r_sigit || exit 8
cp r_sigitdt.ft$hx r_sigitdt || exit 8
cp r_sfc.ft$hx r_sfci || exit 8
#
/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/runs_gmp/runscr/r_post non_batch $EXECDIR \
	$YYYY:$MM:$DD:$HH:$h:$hx:$YYYYS:$MMS:$FHLEN:$ENDHOUR:$INTPOST  ||	exit 8
#
#  post processing
#
if [ no = yes ] ; then
    /rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/etc/catpgb
fi
#
#  Delete old short archive files
#
for file in $LIST_OF_FILES
do
	ftpfile=FTP_`echo $file | tr '[a-z]' '[A-Z]'`
	x=\$$ftpfile
	x=`eval echo $x`
	if [ "$x" = yes ] ; then
		continue
	fi
	rc=0
	for filex in $FILES_TO_BE_KEPT
	do
		if [ $filex = $file ] ; then
			rc=1
		fi
	done
	if [ $rc -eq 1 ] ; then
		continue
	fi
	rc=0
	for filex in $FILES_TO_BE_AVERAGED
	do
		if [ $filex = $file ] ; then
			rc=1
		fi
	done
	if [ $rc -eq 1 ] ; then
		continue
	fi
	/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/runs_gmp/runscr/delfile $file $h $hx $INTPOST || exit 8
done
#
# delete base or coarse grid boundary condition for $h
#
if [ "$DELETE_BASE" = yes ] ; then
	fh=0
	while [ $fh -lt $INCHOUR ] ; do
		fhx=`expr $fh + $h`
		/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/etc/incdte $YYYY $MM $DD $HH $fhx  >dteout$$ || exit 8
		read YYYYF  MMF  DDF  HHF  <dteout$$ ; rm dteout$$
		rm base.$YYYYF$MMF$DDF$HHF
		fh=`expr $fh + $NESTING_HOUR`
	done
fi
#
exit 0

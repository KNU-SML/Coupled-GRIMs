#!/bin/sh
set -x
#
#  forecast namelist data
#
#  $1 ... INCHOUR forecast length of the segment
#  $2 ... ENDHOUR forecast hour to the end
#  $3 ... DELTAT_REG regional model time step
#  $4 ... NESTING_HOUR
#  $5 ... regional output interval in hour unit
#  $6 ... sfc call interval
#
#  The following variables can be overwritten by defining it in
#  the calling program and by exporting it
#
#      SWHR_GBL ... short wave radiation interval in hour unit (default 6)
#      LWHR_GBL ... long wave radiation interval in hour unit (default 6)
#      SWHR_REG ... short wave radiation interval in hour unit (default 6)
#      LWHR_REG ... long wave radiation interval in hour unit (default 6)
#      NESTING_HOUR ... nesting interval in hour unit
#      LOCDF_REG .. local diffusion
#      BNDRLXREG .. lateral boundary relaxation 
#
if [ $# -ne 9 ] ; then
	echo $0: wrong number of arguments
	exit 8
fi
#
INCHOUR=$1
ENDHOUR=$2
DELTAT_REG=$3
NESTING_HOUR=$4
INTPOST=$5
INTSFCX=$6
INTOMLX=$7
LOCDF_REG=$8
INTRESTART=$9
#
INTROMX=${INTROMX:=24}
#
STRHR_REG=${STRHR_REG:=0}
SWHR_GBL=${SWHR_GBL:=6}
LWHR_GBL=${LWHR_GBL:=6}
SWHR_REG=${SWHR_REG:=1}
LWHR_REG=${LWHR_REG:=1}
LOCDF_REG=${LOCDF_REG:=0}
BNDRLXREG=${BNDRLXREG:=1}
#
NESTSEC=`expr $NESTING_HOUR \* 3600`
#
cat >rfcst.parm <<EOF
 &NAMSMF 
 INCHOUR=$INCHOUR,
 NUM(5)=0,                   
 CON(1)=-1.,CON(3)=0.,
 CON(4)=$SWHR_GBL.,CON(5)=$LWHR_GBL.,
 CON(7)=$INCHOUR.,CON(9)=$INTPOST.,
 CON(17)=$ENDHOUR.,
 CON(11)=$DELTAT_REG.,CON(12)=$NESTSEC.,
 CON(13)=0.,
 CON(14)=$SWHR_REG.,CON(15)=$LWHR_REG.,
 CON(16)=$STRHR_REG.,
 CON(18)=$LOCDF_REG.,CON(19)=$BNDRLXREG.,
 CON(20)=$INTSFCX.,
 CON(21)=$INTRESTART.,
 CON(22)=$INTOMLX.,CON(29)=$INTROMX.,
/
EOF
cat rsm.parm >>rfcst.parm
cat >>rfcst.parm <<EOF
 &NAMSFC
 FNOROG='$EXECDIR/r_smooth_oroggd'
 FNMASK='$EXECDIR/r_slmsk'
 FNMSKG='/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/con/clim.maskh.grib'
 CONDIR='/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/libs_gmp/con'
 BINDIR='/rhome/soo/NEMO/couple/couple_ice/gmp_v3.2/runs_gmp/../srcs_gmp/bin'
 FNGRB(1)='clim.glacier.grib    '
 FNGRB(2)='clim.maxice.grib     '
 FNGRB(4)='$ICE_GRB'
 FNGRB(5)='$SCV_GRB'
 FNGRB(6)='$SNO_GRB'
 FNGRB(7)='$SST_GRB'
 FNGRB(8)='clim.yhalbedo.grib   '
 FNGRB(9)='clim.sibalbedo.grib  '
 FNGRB(10)='clim.yhalbedo.grib   '
 FNGRB(13)='clim.sibrough.grib   '
 FNGRB(14)='clim.sibresis.grib   '
 FNGRB(18)='clim.vegfrac.grib '
/
EOF
if [ $iicegrb -eq 1 ]; then
    echo " lfgrb(1,4)=f" >> rfcst.parm
    echo " lfgrb(2,4)=f" >> rfcst.parm
    echo " lfgrb(3,4)=t" >> rfcst.parm
    echo " lfgrb(4,4)=f" >> rfcst.parm
    echo " lfgrb(5,4)=f" >> rfcst.parm
else
    echo " lfgrb(1,4)=F" >> rfcst.parm
    echo " lfgrb(2,4)=F" >> rfcst.parm
    echo " lfgrb(3,4)=F" >> rfcst.parm
    echo " lfgrb(4,4)=F" >> rfcst.parm
    echo " lfgrb(5,4)=F" >> rfcst.parm
fi
if [ $isnogrb -eq 1 ]; then
    echo " lfgrb(1,6)=T" >> rfcst.parm
    echo " lfgrb(2,6)=T" >> rfcst.parm
    echo " lfgrb(3,6)=T" >> rfcst.parm
    echo " lfgrb(4,6)=T" >> rfcst.parm
    echo " lfgrb(5,6)=T" >> rfcst.parm
else
    echo " lfgrb(1,6)=F" >> rfcst.parm
    echo " lfgrb(2,6)=F" >> rfcst.parm
    echo " lfgrb(3,6)=F" >> rfcst.parm
    echo " lfgrb(4,6)=F" >> rfcst.parm
    echo " lfgrb(5,6)=F" >> rfcst.parm
fi
if [ $isstgrb -eq 1 ]; then
    echo " lfgrb(1,7)=T" >> rfcst.parm
    echo " lfgrb(2,7)=F" >> rfcst.parm
    echo " lfgrb(3,7)=F" >> rfcst.parm
    echo " lfgrb(4,7)=F" >> rfcst.parm
    echo " lfgrb(5,7)=F" >> rfcst.parm
else
    echo " lfgrb(1,7)=F" >> rfcst.parm
    echo " lfgrb(2,7)=F" >> rfcst.parm
    echo " lfgrb(3,7)=F" >> rfcst.parm
    echo " lfgrb(4,7)=F" >> rfcst.parm
    echo " lfgrb(5,7)=F" >> rfcst.parm
fi
if [ $ism2grb -eq 1 ]; then
    echo " lfgrb(1,11)=F" >> rfcst.parm
    echo " lfgrb(2,11)=T" >> rfcst.parm
    echo " lfgrb(3,11)=F" >> rfcst.parm
    echo " lfgrb(4,11)=T" >> rfcst.parm
    echo " lfgrb(5,11)=F" >> rfcst.parm
else
    echo " lfgrb(1,11)=F" >> rfcst.parm
    echo " lfgrb(2,11)=F" >> rfcst.parm
    echo " lfgrb(3,11)=F" >> rfcst.parm
    echo " lfgrb(4,11)=F" >> rfcst.parm
    echo " lfgrb(5,11)=F" >> rfcst.parm
fi
#

